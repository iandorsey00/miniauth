{
  "name": "miniauth",
  "version": "0.1.1",
  "private": true,
  "description": "MiniAuth - small shared login service for MiniTickets and related apps",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "prisma generate && eslint .",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "prisma db seed",
    "bootstrap:admin": "node --experimental-strip-types scripts/bootstrap-admin.ts",
    "migrate:minitickets-workspaces": "node --experimental-strip-types scripts/migrate-minitickets-workspaces.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || ^24.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource/inter": "^5.2.8",
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.0",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "prisma": "^7.6.0",
    "typescript": "^5.9.3"
  }
}
